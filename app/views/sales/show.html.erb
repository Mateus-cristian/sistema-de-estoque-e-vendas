
<div class="w-full flex justify-center items-center py-6 px-2">
  <div class="w-full max-w-md bg-white rounded-xl shadow p-6 md:p-8 flex flex-col gap-4">
    <h1 class="text-red-700 font-bold text-2xl">Detalhes da Venda</h1>
    <div class="flex flex-col gap-2">
      <div>
        <span class="font-semibold">Produto:</span>
        <span><%= @sale.product&.name || 'Produto não encontrado' %></span>
      </div>
      <div>
        <span class="font-semibold">Quantidade:</span>
        <span><%= @sale.quantity %></span>
      </div>
      <div>
        <span class="font-semibold">Total:</span>
        <span><%= number_to_currency(@sale.total, unit: 'R$', separator: ',', delimiter: '.') rescue @sale.total %></span>
      </div>
      <div>
        <span class="font-semibold">Usuário:</span>
        <span><%= @sale.user&.name || 'Usuário não encontrado' %></span>
      </div>
    </div>
    <div class="flex gap-2 mt-4">
      <%= link_to "Voltar para Vendas", sales_path, class: 'button-outline' %>
    </div>
  </div>
</div>