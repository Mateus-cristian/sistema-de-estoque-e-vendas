<h1>Sale Details</h1>
<p>
  <strong>Product:</strong> <%= @sale.product.name %><br>
  <strong>Quantity:</strong> <%= @sale.quantity %><br>
  <strong>Total:</strong> <%= @sale.total %><br>
  <strong>User:</strong> <%= @sale.user.email %>
</p>
<%= link_to "Voltar para Vendas", sales_path %>
<% if policy(@sale).destroy? %>
  <%= button_to 'Remover', sale_path(@sale), method: :delete, data: { confirm: 'Tem certeza?' } %>
<% end %>