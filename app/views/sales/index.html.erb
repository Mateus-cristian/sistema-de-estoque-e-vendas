<h1>Sales</h1>
<%= link_to "Nova Venda", new_sale_path %>
<ul>
  <% @sales.each do |sale| %>
    <li >
  <%= link_to sale.product.name, sale_path(sale) %> - <%= sale.quantity %> - <%= sale.total %>
      <% if policy(sale).destroy? %>
  <%= button_to 'Remover', sale_path(sale), method: :delete, data: { confirm: 'Tem certeza?' } %>
      <% end %>
    </li>
  <% end %>
</ul>