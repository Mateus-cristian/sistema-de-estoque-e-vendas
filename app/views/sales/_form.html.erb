<%= form_with(model: sale, url: sales_path, data: { turbo_frame: "sale_form" }, class: "flex flex-col gap-4", id: "sale_form") do |form| %>
  <div class="flex flex-col gap-1">
    <%= form.label :product_id, "Produto", class: "font-semibold" %>
    <div class="relative">
      <%= form.collection_select :product_id, Product.all, :id, :name, { prompt: "Selecione um produto" }, { class: "border rounded px-3 py-2 w-full appearance-none pr-8" } %>
      <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-700">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M19 9l-7 7-7-7"/>
        </svg>
      </div>
    </div>
    <% if sale.errors[:product_id].present? %>
      <span class="text-red-600 text-sm"><%= sale.errors[:product_id].first %></span>
    <% end %>
  </div>

  <div class="flex flex-col gap-1">
    <%= form.label :quantity, "Quantidade", class: "font-semibold" %>
    <%= form.number_field :quantity, class: "border rounded px-3 py-2 w-full" %>
    <% if sale.errors[:quantity].present? %>
      <span class="text-red-600 text-sm"><%= sale.errors[:quantity].first %></span>
    <% end %>
  </div>

  <div>
    <%= form.submit sale.persisted? ? "Atualizar" : "Salvar", class: "button-solid w-full" %>
  </div>
<% end %>
