<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Sistema Estoque" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen" >
    <main class=" bg-gray-50">
 
        <% unless controller_name.in?(%w[sessions registrations passwords]) %>
        <nav class="flex justify-end items-center gap-4 bg-gray-100 p-4 rounded mb-8">
          <% if user_signed_in? %>
            <% if current_user.admin? %>
              <%= link_to "Admin Dashboard", admin_dashboard_path, class: "text-green-600 font-semibold hover:underline" %>
            <% end %>
            <%= link_to "Home", root_path, class: "text-green-600 font-semibold hover:underline" %>
            <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "text-red-600 font-semibold cursor-pointer hover:underline bg-transparent " %>
          <% else %>
            <%= link_to "Log in", new_user_session_path, class: "text-blue-600 font-semibold hover:underline" %>
            <%= link_to "Sign up", new_user_registration_path, class: "text-blue-600 font-semibold hover:underline" %>
          <% end %>
        </nav>
      <% end %>

      <% if flash[:alert] %>
        <div class="alert"><%= flash[:alert] %></div>
      <% end %>
      <% if flash[:notice] %>
        <div class="notice"><%= flash[:notice] %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
