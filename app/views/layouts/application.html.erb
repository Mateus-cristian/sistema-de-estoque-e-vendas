<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Sistema Estoque" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= favicon_link_tag 'archive-box.svg' %>
  </head>

  <body class="min-h-screen" >
    <main class=" bg-gray-50">
 
      
        <% if user_signed_in? %>
        <nav class=" bg-gray-100 py-4 rounded w-full flex justify-center">
          <div class="container flex justify-between items-center w-full">
            <div class="text-2xl font-bold text-red-700 flex items-center gap-2 justify-center">
              <div class="text-red-600 text-sm md:text-2xl flex items-center">
                <%= heroicon("archive-box", variant: :solid, options: {class: "w-1em h-1em align-middle"}) %>
              </div>
              <span class="text-red-700 text-sm md:text-2xl">Estoque e cia</span>
            </div>
            <div class="flex gap-4">
                <% if current_user.admin? %>
                  <%= link_to "Admin Dashboard", admin_dashboard_path, class: "link-redirect" %>
                <% end %>
                <%= link_to "Home", root_path, class: "link-redirect" %>
                <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "link-redirect " %>
            </div>
          </div>
        </nav>
        <% end %>

      <%= turbo_frame_tag "toast" do %>
        <%= render "shared/toast" %>
      <% end %>
      <% if user_signed_in? %>
      <div class="min-h-[calc(100vh-64px)]">
        <%= yield %>
      </div>
      <% else %>
        <%= yield %>
      <% end %>
    </main>
  </body>
</html>
