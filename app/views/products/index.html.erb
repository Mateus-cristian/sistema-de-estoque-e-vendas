
<div class="flex justify-between p-3 pt-6 md:container md:justify-self-center">
  <h1 class="font-bold text-red-700 text-2xl">Produtos</h1>
  <% if policy(Product).create? %>
    <%= link_to "Novo Produto", new_product_path, class: "button-outline max-w-[120px]", data: { turbo_frame: "_top" } %>
  <% end %>
</div>

<%= turbo_frame_tag "products_list" do %>
  <%= render partial: "products/products_list", locals: { products: @products } %>
<% end %>