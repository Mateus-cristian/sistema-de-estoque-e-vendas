<h1>Produtos</h1>
<% if policy(Product).create? %>
  <%= link_to "Novo Produto", new_product_path %>
<% end %>

<%= turbo_frame_tag "products_list" do %>
  <ul class="flex flex-col gap-1">
    <% @products.each do |product| %>
      <li id="<%= dom_id(product) %>" class="flex gap-2 items-center">
        <span><%= product.name %> - R$ <%= product.price %> - Estoque: <%= product.quantity %></span>
        <% if policy(product).edit? %>
          - <%= link_to "Editar", edit_product_path(product), class: "ml-2" %>
            - <%= link_to "Editar (Form Page)", form_page_product_path(product), class: "ml-2" %>
        <% end %>
        <% if policy(product).destroy? %>
          |<%= button_to "Remover", product_path(product), method: :delete, data: { turbo_confirm: "Tem certeza?" }, form: { data: { turbo_frame: "_top" } }, class: "ml-2" %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>