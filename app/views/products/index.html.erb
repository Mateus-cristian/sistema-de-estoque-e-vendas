<h1>Produtos</h1>
<%= link_to "Novo Produto", new_product_path %>

<%= turbo_frame_tag "products_list" do %>
  <ul>
    <% @products.each do |p| %>
      <li id="<%= dom_id(p) %>" class="flex gap-1">
        <%= p.name %> - <%= p.price %> - <%= p.quantity %>
        <div class="flex gap-2">
          <%= link_to "Editar", form_page_product_path(p) %> |
          <%= button_to "Remover", product_path(p), method: :delete, data: { turbo_confirm: "Tem certeza?" }, form: { data: { turbo_frame: "_top" } } %>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>