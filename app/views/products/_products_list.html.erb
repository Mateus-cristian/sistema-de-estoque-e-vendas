<% cache products do %>
  <ul class="flex flex-col  shadow rounded mx-2 md:hidden">
    <% products.each_with_index do |product, index| %>
      <% cache product do %>
      <li id="<%= dom_id(product) %>" class="px-3 py-2 flex flex-col ">
        <% if index > 0 %>
        <div class="py-1 border-t border-gray-200 "></div>
        <% end %>
        <div class="font-semibold">Nome</div>
        <span class="text-md"><%= product.name %></span>
        <div class="font-semibold">Valor</div>
        <span class="">R$ <%= product.price %></span>
        <div class="font-semibold">Estoque</div>
        <span class=""><%= product.quantity %></span>
        <div class="flex gap-2 mt-2">
          <% if policy(product).edit? %>
            <%= link_to "Editar", form_page_product_path(product), class: "text-green-500 hover:underline", data: { turbo_frame: "_top" } %>
          <% end %>
          <% if policy(product).destroy? %>
            <%= button_to "Remover", product_path(product), method: :delete, data: { turbo_confirm: "Tem certeza?" }, form: { data: { turbo_frame: "_top" } }, class: "text-red-500 hover:underline" %>
          <% end %>
        </div>
      </li>
      <% end %>
    <% end %>
  </ul>
<% end %>
<div class="w-full flex justify-center">
  <div class="overflow-x-auto container hidden md:block">
    <table class="table">
      <thead>
        <tr>
          <th>Nome</th>
          <th>Valor</th>
          <th>Estoque</th>
          <th></th>
        </tr>
      </thead>
      <% cache products do %>
      <tbody>
        <% products.each do |product| %>
          <% cache product do %>
          <tr>
            <td>
              <span class="text-md"><%= product.name %></span>
            </td>
            <td>
              <span class="text-md">R$ <%= product.price %></span>
            </td>
            <td>
              <span class="text-md"><%= product.quantity %></span>
            </td>
            <% if policy(product).edit? %>
            <th>
              <%= link_to "Editar", form_page_product_path(product), class: "ml-2 text-green-500 hover:underline", data: { turbo_frame: "_top" } %>
            </th>
            <% end %>
            <% if policy(product).destroy? %>
            <th>
              <%= button_to "Remover", product_path(product), method: :delete, data: { turbo_confirm: "Tem certeza?" }, form: { data: { turbo_frame: "_top" } }, class: "ml-2 text-red-500 hover:underline" %>
            </th>
            <% end %>
          </tr>
          <% end %>
        <% end %>
      </tbody>
      <% end %>
      <!-- TODO: Pagination -->
      <!-- <tfoot>
        <tr>
          <th></th>
          <th></th>
          <th></th>
          <th></th>
          <th></th>
        </tr>
      </tfoot> -->
    </table>
  </div>
</div>
