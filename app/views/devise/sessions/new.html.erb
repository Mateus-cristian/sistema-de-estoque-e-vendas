<div class="flex items-center justify-center min-h-screen w-full">
  <div class="bg-white border border-neutral-300 rounded-lg min-w-[320px] min-h-[320px] max-w-[90%] w-full py-8 px-6 md:max-w-[468px] md:p-14 flex flex-col justify-between">

    <header class="text-center mb-6">
      <h1 class="font-bold text-2xl md:text-3xl">Sistema Estoque</h1>
      <h2 class="text-neutral-600 mt-2 leading-tight">Controle de estoque e vendas</h2>
    </header>

    <div class="flex flex-col">
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "flex flex-col gap-4" }) do |f| %>
        
        <div class="flex flex-col gap-1">
          <%= f.label :email, class: "font-semibold" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "border rounded px-3 py-2 w-full" %>
          <% if resource.errors[:email].present? %>
            <span class="text-red-600 text-sm"><%= resource.errors[:email].first %></span>
          <% end %>
        </div>

        <div class="flex flex-col gap-1">
          <%= f.label :password, class: "font-semibold" %>
          <%= f.password_field :password, autocomplete: "current-password", class: "border rounded px-3 py-2 w-full" %>
          <% if resource.errors[:password].present? %>
            <span class="text-red-600 text-sm"><%= resource.errors[:password].first %></span>
          <% end %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center gap-2">
            <%= f.check_box :remember_me %>
            <%= f.label :remember_me %>
          </div>
        <% end %>

        <div>
          <%= f.submit "Login", class: "bg-red-700 text-white py-3 rounded w-full cursor-pointer hover:bg-red-600" %>
        </div>

      <% end %>
    </div>

    <!-- Footer links -->
    <footer class="flex flex-col gap-2 mt-6">
      <%= link_to "Esqueci minha senha", new_user_password_path, class: "text-red-700 font-semibold text-center" %>
      <%= link_to "Criar uma conta", new_user_registration_path, class: "text-red-700 font-semibold text-center" %>
    </footer>

  </div>
</div>
