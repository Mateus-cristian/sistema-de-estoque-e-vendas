<div class="flex flex-col gap-6 md:container md:mx-auto p-4">
  <div class="flex items-center justify-between mb-2">
    <h1 class="font-bold text-red-700 text-2xl">Relatório de Estoque Baixo</h1>
    <%= render "shared/back_button", back_path: admin_dashboard_path %>
  </div>
  <div class="bg-white rounded-xl shadow p-4 flex flex-col gap-4">
    <%= form_with url: admin_stock_report_path, method: :get, local: true, class: "flex flex-col md:flex-row md:items-end gap-2 md:gap-4" do |f| %>
      <div class="flex flex-col">
        <label class="font-semibold">Limite:</label>
        <%= f.number_field :threshold, value: @threshold, class: "border rounded px-3 py-2" %>
      </div>
      <%= f.submit "Filtrar", class: "button-outline w-full md:w-auto" %>
    <% end %>
  </div>

  <div class="bg-white rounded-xl shadow p-4 flex flex-col gap-2 mt-4">
    <h2 class="font-bold text-lg text-gray-700 mb-2">Produtos com Estoque Baixo</h2>
    <ul class="flex flex-col gap-2">
      <% @products.each do |product| %>
        <li class="flex justify-between items-center border-b last:border-b-0 pb-2">
          <span class="font-medium truncate max-w-[60%]"> <%= product.name %> </span>
          <span class="text-red-600 font-semibold min-w-[60px] text-right">Qtd: <%= product.quantity %></span>
        </li>
      <% end %>
      <% if @products.empty? %>
        <li class="text-gray-500">Nenhum produto com estoque baixo.</li>
      <% end %>
    </ul>
  </div>
</div>