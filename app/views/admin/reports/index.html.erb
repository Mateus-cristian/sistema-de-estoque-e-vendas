<h1>Relatório de Vendas</h1>

<%= form_with url: admin_reports_path, method: :get, local: true do |f| %>
  <label>Início:</label>
  <%= f.date_field :start_date, value: @start_date %>
  <label>Fim:</label>
  <%= f.date_field :end_date, value: @end_date %>
  <%= f.submit "Filtrar" %>
<% end %>

<ul>
  <% @sales.each do |sale| %>
    <li>
      <%= sale.product.name %> - <%= sale.quantity %> - <%= l(sale.created_at, format: :short) %>
    </li>
  <% end %>
</ul>