<div class="flex flex-col gap-6 md:container md:mx-auto p-4">
  <div class="flex flex-col md:flex-row md:justify-between md:items-center gap-4">
    <h1 class="font-bold text-red-700 text-2xl">Dashboard</h1>
    <div class="flex gap-2">
      <%= link_to "Relatório de Vendas", admin_reports_path, class: "button-outline" %>
      <%= link_to "Relatório de Estoque", admin_stock_report_path, class: "button-outline" %>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow p-4 flex flex-col gap-2 mt-4">
    <div class="text-lg font-semibold text-gray-700">Total de vendas: <span class="text-red-700 font-bold"><%= @total_sales %></span></div>
  </div>

  <div class="bg-white rounded-xl shadow p-4 flex flex-col gap-2 mt-4">
    <h2 class="font-bold text-lg text-gray-700 mb-2">Produtos com estoque baixo</h2>
    <ul class="flex flex-col gap-2">
      <% @low_stock_products.each do |product| %>
        <li class="flex justify-between items-center border-b last:border-b-0 pb-2">
          <span class="font-medium"><%= product.name %></span>
          <span class="text-red-600 font-semibold">Qtd: <%= product.quantity %></span>
        </li>
      <% end %>
      <% if @low_stock_products.empty? %>
        <li class="text-gray-500">Nenhum produto com estoque baixo.</li>
      <% end %>
    </ul>
  </div>
</div>